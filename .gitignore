# ──────────────────────────────────────────────────────
# JARVIS AI — .gitignore
# ALL secrets, keys, databases, and private data are EXCLUDED
# ──────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-electron/
build/
out/
release/

# ── SECRETS & API KEYS (NEVER commit these) ───────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env*.txt
*.env
secrets.json
secrets.yaml
secrets.ts
**/apikey*
**/api_key*
**/API_KEY*
**/*secret*
**/*credential*
**/*private_key*
config/credentials.*
keyVault.json
key_vault.json
key-vault.json

# ── DATABASE FILES ─────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db.bak*
assistant_data.db*
data/

# ── GENERATED SITES & PROJECT OUTPUT ──────────────────
generated_sites/
generated_projects/
artifacts/

# ── ELECTRON RELEASE ARTIFACTS ─────────────────────────
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm
*.msi
*.pkg
*.zip
*.tar.gz

# ── EDITOR & IDE ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── LOGS ───────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TEMP & CACHE ───────────────────────────────────────
*.tmp
*.temp
temp/
.tmp/
.cache/
.parcel-cache/
.turbo/

# ── GENERATED / AUTO-CREATED ───────────────────────────
routeTree.gen.ts
open-ai/

# ── COVERAGE ───────────────────────────────────────────
coverage/
.nyc_output/
